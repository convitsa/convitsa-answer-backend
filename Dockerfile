# Build stage
FROM oven/bun:1 AS builder

WORKDIR /app

# Copy package files
COPY package.json bun.lockb ./

# Install dependencies
RUN bun install --frozen-lockfile

# Copy source
COPY . .

# Production stage
FROM oven/bun:1-slim AS production

WORKDIR /app

# Build arguments for environment variables
ARG NODE_ENV=production
ARG PORT=3000

# MongoDB & Redis
ARG MONGODB_URI
ARG REDIS_URL

# Azure OpenAI
ARG AZURE_OPENAI_ENDPOINT
ARG AZURE_OPENAI_API_KEY
ARG AZURE_OPENAI_API_VERSION=2024-08-01-preview
ARG AZURE_OPENAI_CHAT_DEPLOYMENT
ARG AZURE_OPENAI_EMBEDDING_DEPLOYMENT

# Azure Blob Storage
ARG AZURE_BLOB_CONNECTION_STRING
ARG AZURE_BLOB_CONTAINER_NAME

# Azure Vision (OCR)
ARG AZURE_VISION_ENDPOINT
ARG AZURE_VISION_KEY

# Firecrawl
ARG FIRECRAWL_API_KEY
ARG CRAWL_MAX_PAGES
ARG CRAWL_TIMEOUT_SECONDS

# Email (Resend)
ARG RESEND_API_KEY
ARG RESEND_FROM_EMAIL

# JWT Authentication
ARG JWT_SECRET
ARG JWT_REFRESH_SECRET
ARG JWT_EXPIRES_IN=1h
ARG JWT_REFRESH_EXPIRES_IN=7d

# Document Upload Limits
ARG MAX_FILE_SIZE_MB=50
ARG MAX_FILES_PER_PROJECT=100
ARG MAX_STORAGE_PER_PROJECT_MB=500

# Gumroad Webhook
ARG GUMROAD_SELLER_ID
ARG GUMROAD_WEBHOOK_TOKEN

# WebSocket
ARG MAX_WS_CONNECTIONS_PER_KEY=100

# Pricing Configuration
ARG TOKENS_PER_CREDIT
ARG PLATFORM_COMMISSION_PERCENT

# Tier Configuration
ARG FREE_CONTEXT_CHUNKS
ARG PRO_CONTEXT_CHUNKS
ARG FREE_MAX_TOKENS
ARG PRO_MAX_TOKENS
ARG FREE_MAX_MESSAGES_PER_SESSION

# Rate Limiting
ARG RATE_LIMIT_FREE_MESSAGES_PER_MIN
ARG RATE_LIMIT_PRO_MESSAGES_PER_MIN

# Set environment variables
ENV NODE_ENV=${NODE_ENV}
ENV PORT=${PORT}

ENV MONGODB_URI=${MONGODB_URI}
ENV REDIS_URL=${REDIS_URL}

ENV AZURE_OPENAI_ENDPOINT=${AZURE_OPENAI_ENDPOINT}
ENV AZURE_OPENAI_API_KEY=${AZURE_OPENAI_API_KEY}
ENV AZURE_OPENAI_API_VERSION=${AZURE_OPENAI_API_VERSION}
ENV AZURE_OPENAI_CHAT_DEPLOYMENT=${AZURE_OPENAI_CHAT_DEPLOYMENT}
ENV AZURE_OPENAI_EMBEDDING_DEPLOYMENT=${AZURE_OPENAI_EMBEDDING_DEPLOYMENT}

ENV AZURE_BLOB_CONNECTION_STRING=${AZURE_BLOB_CONNECTION_STRING}
ENV AZURE_BLOB_CONTAINER_NAME=${AZURE_BLOB_CONTAINER_NAME}

ENV AZURE_VISION_ENDPOINT=${AZURE_VISION_ENDPOINT}
ENV AZURE_VISION_KEY=${AZURE_VISION_KEY}

ENV FIRECRAWL_API_KEY=${FIRECRAWL_API_KEY}
ENV CRAWL_MAX_PAGES=${CRAWL_MAX_PAGES}
ENV CRAWL_TIMEOUT_SECONDS=${CRAWL_TIMEOUT_SECONDS}

ENV RESEND_API_KEY=${RESEND_API_KEY}
ENV RESEND_FROM_EMAIL=${RESEND_FROM_EMAIL}

ENV JWT_SECRET=${JWT_SECRET}
ENV JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
ENV JWT_EXPIRES_IN=${JWT_EXPIRES_IN}
ENV JWT_REFRESH_EXPIRES_IN=${JWT_REFRESH_EXPIRES_IN}

ENV MAX_FILE_SIZE_MB=${MAX_FILE_SIZE_MB}
ENV MAX_FILES_PER_PROJECT=${MAX_FILES_PER_PROJECT}
ENV MAX_STORAGE_PER_PROJECT_MB=${MAX_STORAGE_PER_PROJECT_MB}

ENV GUMROAD_SELLER_ID=${GUMROAD_SELLER_ID}
ENV GUMROAD_WEBHOOK_TOKEN=${GUMROAD_WEBHOOK_TOKEN}

ENV MAX_WS_CONNECTIONS_PER_KEY=${MAX_WS_CONNECTIONS_PER_KEY}

ENV TOKENS_PER_CREDIT=${TOKENS_PER_CREDIT}
ENV PLATFORM_COMMISSION_PERCENT=${PLATFORM_COMMISSION_PERCENT}

ENV FREE_CONTEXT_CHUNKS=${FREE_CONTEXT_CHUNKS}
ENV PRO_CONTEXT_CHUNKS=${PRO_CONTEXT_CHUNKS}
ENV FREE_MAX_TOKENS=${FREE_MAX_TOKENS}
ENV PRO_MAX_TOKENS=${PRO_MAX_TOKENS}
ENV FREE_MAX_MESSAGES_PER_SESSION=${FREE_MAX_MESSAGES_PER_SESSION}

ENV RATE_LIMIT_FREE_MESSAGES_PER_MIN=${RATE_LIMIT_FREE_MESSAGES_PER_MIN}
ENV RATE_LIMIT_PRO_MESSAGES_PER_MIN=${RATE_LIMIT_PRO_MESSAGES_PER_MIN}

# Copy from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./
COPY --from=builder /app/src ./src
COPY --from=builder /app/tsconfig.json ./

# Install curl for health check
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 bunjs
USER bunjs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3000/api/v1/health || exit 1

# Start server
CMD ["bun", "run", "src/index.ts"]
