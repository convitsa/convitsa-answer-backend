# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/convitsa?retryWrites=true&w=majority

# Redis
# Local Redis:
# REDIS_URL=redis://localhost:6379
# Azure Managed Redis (requires TLS, use rediss:// and port 6380):
REDIS_URL=rediss://:your-access-key@your-redis-name.redis.cache.windows.net:6380

# Azure OpenAI - REQUIRED
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Firecrawl
FIRECRAWL_API_KEY=your-firecrawl-api-key

# Resend Email
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@convitsa.com

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_SECRET=your-jwt-secret-at-least-32-characters-long-for-security
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_FREE_MESSAGES_PER_MIN=5
RATE_LIMIT_PRO_MESSAGES_PER_MIN=30
MAX_WS_CONNECTIONS_PER_KEY=100

# Tier Configuration
FREE_CONTEXT_CHUNKS=3
PRO_CONTEXT_CHUNKS=10
FREE_MAX_TOKENS=500
PRO_MAX_TOKENS=2000
FREE_MAX_MESSAGES_PER_SESSION=15

# Pricing Configuration
TOKENS_PER_CREDIT=1000
PLATFORM_COMMISSION_PERCENT=25
# Token Conversion: How many OpenAI tokens = 1 Convitsa token
# Default: 30 (optimized for 60% profit margin)
# So 2500 OpenAI tokens = ~83 Convitsa tokens deducted
OPENAI_TO_CONVITSA_RATE=30

# Crawl Configuration
CRAWL_MAX_PAGES=20
CRAWL_TIMEOUT_SECONDS=120

# Azure Blob Storage
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-storage-account;AccountKey=your-key;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER_NAME=convitsa-documents

# Azure Computer Vision (for OCR on images)
AZURE_VISION_ENDPOINT=https://your-vision-resource.cognitiveservices.azure.com
AZURE_VISION_KEY=your-vision-api-key

# Document Upload Configuration
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_PROJECT=100
MAX_STORAGE_PER_PROJECT_MB=500

# Gumroad (DEPRECATED - kept for backwards compatibility)
# GUMROAD_SELLER_ID=your-gumroad-seller-id
# GUMROAD_WEBHOOK_TOKEN=your-secret-webhook-token-here

# Dodo Payments (for subscription payments)
# Get your API key from: https://app.dodopayments.com/developer/api
DODO_PAYMENTS_API_KEY=your-dodo-payments-api-key
DODO_PAYMENTS_WEBHOOK_KEY=your-webhook-secret-min-16-chars
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Optional: URL to redirect after payment (if not set, user stays on Dodo success page)
# DODO_PAYMENTS_RETURN_URL=https://your-app.com/subscription/success
# Product IDs for checkout (create in Dodo dashboard)
DODO_PRO_PRODUCT_ID=pdt_your_pro_product_id
DODO_BUSINESS_PRODUCT_ID=pdt_your_business_product_id

# Subscription Plan Configuration (Convitsa tokens per month)
# Optimized for 60% profit margin
FREE_TOKENS_PER_MONTH=5000
PRO_TOKENS_PER_MONTH=100000
BUSINESS_TOKENS_PER_MONTH=250000

# Project Limits per Tier
FREE_PROJECTS_LIMIT=1
PRO_PROJECTS_LIMIT=5
BUSINESS_PROJECTS_LIMIT=999

# Affiliate Program Configuration
AFFILIATE_BONUS_TOKENS=5000

# Magic Link Configuration (for password setup)
MAGIC_LINK_EXPIRY_HOURS=24
PASSWORD_SETUP_URL=https://answer.convitsa.com/password/reset

